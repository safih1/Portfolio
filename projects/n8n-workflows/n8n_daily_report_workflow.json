{
  "name": "Automated Daily Sales Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      },
      "id": "schedule-9am",
      "name": "Every Day 9 AM (Mon-Fri)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_URL",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sales",
          "mode": "list"
        },
        "options": {
          "range": "A:Z"
        }
      },
      "id": "get-sales-data",
      "name": "Get Sales Data",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calculate daily stats\nconst sales = $input.all();\nconst today = new Date();\nconst yesterday = new Date(today);\nyesterday.setDate(yesterday.getDate() - 1);\n\nconst yesterdayStr = yesterday.toISOString().split('T')[0];\n\n// Filter yesterday's sales\nconst yesterdaySales = sales.filter(sale => {\n  const saleDate = sale.json.Date?.split(' ')[0];\n  return saleDate === yesterdayStr;\n});\n\n// Calculate totals\nconst totalRevenue = yesterdaySales.reduce((sum, sale) => \n  sum + parseFloat(sale.json.Amount || 0), 0);\nconst totalOrders = yesterdaySales.length;\nconst avgOrderValue = totalOrders > 0 ? totalRevenue / totalOrders : 0;\n\n// Top products\nconst productCounts = {};\nyesterdaySales.forEach(sale => {\n  const product = sale.json.Product || 'Unknown';\n  productCounts[product] = (productCounts[product] || 0) + 1;\n});\n\nconst topProducts = Object.entries(productCounts)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5)\n  .map(([name, count]) => `${name}: ${count}`);\n\nreturn [{\n  json: {\n    date: yesterdayStr,\n    totalRevenue: totalRevenue.toFixed(2),\n    totalOrders,\n    avgOrderValue: avgOrderValue.toFixed(2),\n    topProducts: topProducts.join('\\n')\n  }\n}];"
      },
      "id": "calculate-stats",
      "name": "Calculate Daily Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "channel": "#daily-reports",
        "text": "=:bar_chart: *Daily Sales Report - {{ $json.date }}*\n\n:moneybag: *Total Revenue:* ${{ $json.totalRevenue }}\n:shopping_bags: *Total Orders:* {{ $json.totalOrders }}\n:chart_with_upwards_trend: *Avg Order Value:* ${{ $json.avgOrderValue }}\n\n*Top Products:*\n{{ $json.topProducts }}\n\n_Report generated automatically at 9 AM_",
        "otherOptions": {}
      },
      "id": "post-to-slack",
      "name": "Post Report to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        910,
        200
      ]
    },
    {
      "parameters": {
        "fromEmail": "reports@yourbusiness.com",
        "toEmail": "team@yourbusiness.com",
        "subject": "=Daily Sales Report - {{ $json.date }}",
        "emailType": "html",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2 style=\"color: #0066ff;\">Daily Sales Report</h2>\n<p style=\"color: #666;\">{{ $json.date }}</p>\n\n<div style=\"display: flex; gap: 20px; margin: 20px 0;\">\n<div style=\"background: #f0f7ff; padding: 20px; border-radius: 10px; flex: 1; text-align: center;\">\n<h3 style=\"color: #0066ff; margin: 0;\">${{ $json.totalRevenue }}</h3>\n<p style=\"margin: 5px 0 0 0; color: #666;\">Total Revenue</p>\n</div>\n<div style=\"background: #f0f7ff; padding: 20px; border-radius: 10px; flex: 1; text-align: center;\">\n<h3 style=\"color: #0066ff; margin: 0;\">{{ $json.totalOrders }}</h3>\n<p style=\"margin: 5px 0 0 0; color: #666;\">Orders</p>\n</div>\n<div style=\"background: #f0f7ff; padding: 20px; border-radius: 10px; flex: 1; text-align: center;\">\n<h3 style=\"color: #0066ff; margin: 0;\">${{ $json.avgOrderValue }}</h3>\n<p style=\"margin: 5px 0 0 0; color: #666;\">Avg Order</p>\n</div>\n</div>\n\n<h3>Top Products</h3>\n<pre style=\"background: #f5f5f5; padding: 15px; border-radius: 5px;\">{{ $json.topProducts }}</pre>\n\n<p style=\"color: #999; font-size: 12px; margin-top: 30px;\">This report was generated automatically by n8n.</p>\n</div>",
        "options": {}
      },
      "id": "email-report",
      "name": "Email Report to Team",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        910,
        400
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_URL",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Daily Reports",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $json.date }}",
            "Revenue": "={{ $json.totalRevenue }}",
            "Orders": "={{ $json.totalOrders }}",
            "Avg Order Value": "={{ $json.avgOrderValue }}",
            "Generated At": "={{ $now.format('yyyy-MM-dd HH:mm') }}"
          }
        },
        "options": {}
      },
      "id": "archive-report",
      "name": "Archive Report",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1130,
        300
      ]
    }
  ],
