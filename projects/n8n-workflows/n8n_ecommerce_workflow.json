{
  "name": "E-commerce Order Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-order",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "order-webhook",
      "name": "Shopify Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_URL",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Orders",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Order ID": "={{ $json.order_number }}",
            "Customer Name": "={{ $json.customer.first_name }} {{ $json.customer.last_name }}",
            "Email": "={{ $json.customer.email }}",
            "Total": "={{ $json.total_price }}",
            "Items": "={{ $json.line_items.map(item => item.name).join(', ') }}",
            "Status": "Processing",
            "Date": "={{ $now.format('yyyy-MM-dd HH:mm') }}"
          }
        },
        "options": {}
      },
      "id": "log-to-sheets",
      "name": "Log Order to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        470,
        200
      ]
    },
    {
      "parameters": {
        "channel": "#orders",
        "text": "=:shopping_cart: *New Order #{{ $json.order_number }}*\n\n*Customer:* {{ $json.customer.first_name }} {{ $json.customer.last_name }}\n*Email:* {{ $json.customer.email }}\n*Total:* ${{ $json.total_price }}\n*Items:* {{ $json.line_items.map(item => item.name).join(', ') }}",
        "otherOptions": {}
      },
      "id": "slack-order",
      "name": "Notify Slack #orders",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        470,
        400
      ]
    },
    {
      "parameters": {
        "fromEmail": "orders@yourbusiness.com",
        "toEmail": "={{ $json.customer.email }}",
        "subject": "=Order Confirmed! #{{ $json.order_number }}",
        "emailType": "html",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n<h2 style=\"color: #0066ff;\">Thank you for your order!</h2>\n<p>Hi {{ $json.customer.first_name }},</p>\n<p>Your order <strong>#{{ $json.order_number }}</strong> has been confirmed.</p>\n<h3>Order Summary</h3>\n<table style=\"width: 100%; border-collapse: collapse;\">\n{{ $json.line_items.map(item => `<tr><td style=\"padding: 10px; border-bottom: 1px solid #eee;\">${item.name}</td><td style=\"padding: 10px; border-bottom: 1px solid #eee; text-align: right;\">$${item.price}</td></tr>`).join('') }}\n<tr><td style=\"padding: 10px; font-weight: bold;\">Total</td><td style=\"padding: 10px; font-weight: bold; text-align: right;\">${{ $json.total_price }}</td></tr>\n</table>\n<p>We'll send you a tracking number once your order ships.</p>\n<p>Questions? Reply to this email.</p>\n</div>",
        "options": {}
      },
      "id": "confirmation-email",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "high-value-check",
              "leftValue": "={{ parseFloat($json.total_price) }}",
              "rightValue": 100,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-high-value",
      "name": "High Value Order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "channel": "#vip-orders",
        "text": "=:star: *VIP Order Alert!*\n\nOrder #{{ $json.order_number }} is worth *${{ $json.total_price }}*\n\nCustomer: {{ $json.customer.first_name }} {{ $json.customer.last_name }}\nEmail: {{ $json.customer.email }}\n\n_Consider personal follow-up!_",
        "otherOptions": {}
      },
      "id": "vip-alert",
      "name": "VIP Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        1130,
        200
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_URL",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "Inventory",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Stock": "={{ $json.current_stock - $json.quantity }}"
          }
        },
        "options": {}
      },
      "id": "update-inventory",
      "name": "Update Inventory",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [
        1130,
        400
      ]
    }
  ],
  "connections": {
    "Shopify Order Webhook": {
      "main": [
        [
          {
            "node": "Log Order to Sheets",
            "type": "main",
            "index": 0
          },
          {
            "node": "Notify Slack #orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Order to Sheets": {
      "main": [
        [
          {
            "node": "Send Confirmation Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Slack #orders": {
      "main": [
        [
          {
            "node": "Send Confirmation Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Confirmation Email": {
      "main": [
        [
          {
            "node": "High Value Order?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High Value Order?": {
      "main": [
        [
          {
            "node": "VIP Slack Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Update Inventory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "VIP Slack Alert": {
      "main": [
        [
          {
            "node": "Update Inventory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "E-commerce"
    },
    {
      "name": "Shopify"
    },
    {
      "name": "Orders"
    }
  ]
}
