# Copy this file to .env and fill in the values you need.
# Never commit .env.

# ---------------------------------------------------------------------------
# AI (chatbot + lead scoring + outreach)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CHATBOT_SYSTEM_PROMPT=

# ---------------------------------------------------------------------------
# Sender identity (used in outreach copy)
# ---------------------------------------------------------------------------
SENDER_NAME=
SENDER_COMPANY=
PORTFOLIO_URL=
CALENDLY_LINK=

# ---------------------------------------------------------------------------
# Lead sources (optional)
# ---------------------------------------------------------------------------
# Google Cloud -> enable Places API -> create key
GOOGLE_PLACES_API_KEY=

# Meta app -> Page access token with leads_retrieval + pages_read_engagement
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=lead-hunter-verify

# ---------------------------------------------------------------------------
# Email (optional; the app does not send automatically)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=

# ---------------------------------------------------------------------------
# Django client portal
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# Local app
# ---------------------------------------------------------------------------
FLASK_SECRET_KEY=change-this-to-a-long-random-string
LEADHUNTER_DB=projects/lead-hunter/data/leads.db
